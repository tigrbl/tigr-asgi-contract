{
  "$id": "https://tigr.dev/asgi-contract/schemas/events/webtransport.stream.send.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "not": {
    "required": [
      "subsurface"
    ]
  },
  "properties": {
    "body": {},
    "bytes": {},
    "code": {
      "type": "integer"
    },
    "datagram_id": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "emit_id": {
      "minLength": 1,
      "type": "string"
    },
    "completion_level": {
      "enum": [
        "accepted_by_runtime",
        "queued_for_transport",
        "flushed_to_transport",
        "peer_acknowledged"
      ]
    },
    "headers": {
      "type": "array"
    },
    "jsonrpc_complete": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "more": {
      "type": "boolean"
    },
    "more_body": {
      "type": "boolean"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "maximum": 999,
      "minimum": 100,
      "type": "integer"
    },
    "stream_direction": {
      "enum": [
        "bidi",
        "server_to_client"
      ]
    },
    "stream_id": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "text": {
      "type": "string"
    },
    "type": {
      "const": "webtransport.stream.send"
    },
    "framing": {
      "enum": [
        "json",
        "jsonrpc",
        "ndjson",
        "sse",
        "text",
        "bytes",
        "binary"
      ]
    }
  },
  "required": [
    "type",
    "stream_id",
    "stream_direction"
  ],
  "title": "webtransport.stream.send event payload",
  "type": "object"
}
